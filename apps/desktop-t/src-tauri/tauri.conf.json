{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RouteCode-desktop-t",
  "version": "0.1.0",
  "identifier": "com.routecode.desktop-t",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "desktop-t",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/anasx07/routecode/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_YOUR_GENERATED_PUBLIC_KEY"
    }
  }
}
